# Contraseña para entrar al panel (usuario: cualquiera, por ejemplo "admin")
DASHBOARD_PASSWORD=cambia-esto-por-una-clave-larga

# Una entrada por cada cuenta/servicio. "label" es el nombre que verás en el panel.
# platform: vercel | railway | supabase | neon | cloudflare
ACCOUNTS_JSON=[{"platform":"vercel","label":"personal","token":"..."},{"platform":"vercel","label":"trabajo","token":"..."},{"platform":"railway","label":"personal","token":"..."},{"platform":"supabase","label":"cliente-a","token":"..."},{"platform":"neon","label":"personal","token":"..."},{"platform":"cloudflare","label":"personal","token":"..."}]
